generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id String @id @default(uuid())
  name String
  gameId String
  game liveGames @relation(fields: [gameId], references: [id])
  isHost Boolean @default(false)
}

model liveGames {
  id String  @id @default(uuid())
  gameCode String @unique
  roomName String
  mode String
  isPrivate Boolean
  status String @default("waiting")
  hostId String
  clients Client[]
}