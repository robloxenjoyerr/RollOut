// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  // Dieses Schema ist explizit für SQLite
  provider     = "sqlite" 
  // Keine URL hier, die kommt aus der config
}



model Client {
  id String @id @default(uuid())
  clientId String @unique
  name String
  gameId String
  isRolled Boolean @default(false)
  isHost Boolean @default(false)
  joinedAt DateTime @default(now())
  game liveGames @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model liveGames {
  id String  @id @default(uuid())
  roomCode String @unique
  roomName String @default("Room-Name is undefined")
  mode String @default("wheel")
  isPrivate Boolean @default(false)
  status String @default("waiting")
  allowLateRoll Boolean @default(true)
  hostId String 
  hostLeft Boolean @default(false)
  hostLeftAt DateTime?
  lastActivityAt DateTime @default(now())
  clients Client[]
}